---
import { useTranslations, bilingual, localize, categoryLabel, type Lang } from '../i18n/utils';

interface Props {
  entry: any;
  lang: Lang;
  providerNames?: Record<string, string>;
}

const { entry, lang, providerNames = {} } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;

const description = bilingual(d, 'description', lang);
const href = localize(lang, `/agents/${entry.id}/`);

const searchBlob = [d.name, d.description_fr, d.description_en, d.author, d.category, ...(d.worksWith ?? [])]
  .join(' ')
  .toLowerCase()
  .replace(/\s+/g, ' ');
---

<article class="card agent-card" data-item data-search={searchBlob} data-category={d.category}>
  <div class="card-top">
    <h3><a href={href}>{d.name}</a></h3>
    <span class="chip chip-plain">{categoryLabel(lang, d.category)}</span>
  </div>

  <p class="desc">{description}</p>

  <div class="chips">
    <span class="chip">{d.license}</span>
    <span class="chip">{d.author}</span>
  </div>

  <div class="foot">
    <span>
      {
        (d.worksWith ?? []).slice(0, 3).map((id: string) => (
          <span class="chip chip-plain" style="margin-right:4px">{providerNames[id] ?? id}</span>
        ))
      }
    </span>
    <a href={d.repo} target="_blank" rel="noopener noreferrer">{t('agents.viewRepo')} ↗</a>
  </div>
</article>
