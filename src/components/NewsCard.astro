---
import { useTranslations, bilingual, localize, formatDate, newsTypeLabel, type Lang } from '../i18n/utils';

interface Props {
  entry: any;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;

const title = bilingual(d, 'title', lang);
const summary = bilingual(d, 'summary', lang);
const href = localize(lang, `/news/${entry.id}/`);
---

<article class="news-item">
  <div>
    <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time>
    <div style="margin-top:6px">
      <span class={`badge badge-${d.type === 'shutdown' ? 'freemium' : d.type === 'new' ? 'unlimited' : 'local'}`}>
        {newsTypeLabel(lang, d.type)}
      </span>
    </div>
  </div>
  <div>
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
  </div>
</article>
