---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path without locale prefix, e.g. "/providers/" — used for canonical + hreflang. */
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;
const t = useTranslations(lang);
const siteName = t('site.name');

const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');

const site = Astro.site ?? new URL('https://act-free-ai.netlify.app');
const canonical = new URL(localize(lang, path), site);
const altFr = new URL(localize('fr', path), site);
const altEn = new URL(localize('en', path), site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="fr" href={altFr.href} />
    <link rel="alternate" hreflang="en" href={altEn.href} />
    <link rel="alternate" hreflang="x-default" href={altFr.href} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — ${t('news.rss')}`} href={localize(lang, '/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fbfaf7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
