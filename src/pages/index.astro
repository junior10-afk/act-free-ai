---
// Root entry point: send visitors to the French version by default.
// The browser language is taken into account before the fallback kicks in.
const target = '/fr/';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Act-Free AI</title>
    <link rel="canonical" href="https://act-free-ai.netlify.app/fr/" />
    <link rel="alternate" hreflang="fr" href="https://act-free-ai.netlify.app/fr/" />
    <link rel="alternate" hreflang="en" href="https://act-free-ai.netlify.app/en/" />
    <script is:inline>
      (function () {
        var lang = (navigator.language || 'fr').slice(0, 2).toLowerCase();
        window.location.replace(lang === 'en' ? '/en/' : '/fr/');
      })();
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      <a href="/fr/">Français</a> · <a href="/en/">English</a>
    </p>
  </body>
</html>
